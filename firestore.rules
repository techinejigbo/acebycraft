rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. ADMIN CREDENTIALS & SECURITY: STRICT LOCKDOWN!
    // Stored in Firestore; accessible EXCLUSIVELY via Firebase Admin SDK
    // ==========================================
    match /adminSecurity/{docId} {
      allow read, write: if false;
    }

    // ==========================================
    // 2. ANSWER KEYS: STRICT LOCKDOWN!
    // Never exposed to any client. Accessible strictly via Firebase Admin SDK
    // ==========================================
    match /answerKeys/{assessmentId} {
      allow read, write: if false;
    }

    // ==========================================
    // 3. AIRTIME TRANSACTIONS & AUDIT LOGS
    // Tamper-proof; Serverless backend access only
    // ==========================================
    match /airtimeTransactions/{txId} {
      allow read, write: if false;
    }

    // ==========================================
    // 4. PHONE OTP VERIFICATION REQUESTS
    // Prevent client reads of OTP codes
    // ==========================================
    match /otpRequests/{phone} {
      allow read, write: if false;
    }

    // ==========================================
    // 5. USERS (Students)
    // ==========================================
    match /users/{userId} {
      // Allow user to read/write their own profile
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ==========================================
    // 6. SCHOOLS DIRECTORY
    // Registration visitors must be able to view available schools
    // Writes are handled securely via /api/schools
    // ==========================================
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // 7. CURRICULUM SUBJECTS CATALOG
    // Public curriculum subjects for student assessment selection
    // ==========================================
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // 8. VOLUNTEER TEACHERS & CONTRIBUTIONS
    // ==========================================
    match /teachers/{teacherId} {
      allow read: if isAuthenticated() && isOwner(teacherId);
      allow write: if false; // Provisioned via API
    }

    match /teacherContributions/{contribId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow update, delete: if false; // Only Admin SDK approves/rejects
    }

    // ==========================================
    // 9. WEEKLY ASSESSMENTS & QUESTIONS
    // Client-safe questions subcollections (no answer keys or secret solutions)
    // ==========================================
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /{allSubcollections=**} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // ==========================================
    // 10. SUBMISSIONS & ASSESSMENT ATTEMPTS
    // Students can read their own submission.
    // Schools can only read submissions from their own registered school.
    // ==========================================
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid ||
        resource.data.schoolId == request.auth.uid
      );
      allow write: if false; // Graded strictly via server-side /api/grade-weekly-assessment
    }

    // ==========================================
    // 11. SUNDAY NIGHT WEEKLY REPORTS & COMMUNITY LEADERBOARDS
    // ==========================================
    match /weeklyReports/{cycleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ==========================================
    // 12. PLATFORM & SYSTEM SETTINGS
    // Quotas, airtime amounts, pass mark cutoff
    // ==========================================
    match /platformSettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /systemSettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
